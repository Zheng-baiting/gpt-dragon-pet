<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="龙娘 · 工作间" ShowInTaskbar="False" Width="610" Height="900" MinWidth="540" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#FAF9FC" FontFamily="Microsoft YaHei UI" Foreground="#292532">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#564269"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderBrush" Value="#E1DBE8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EEE7F7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#8460A4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,10,0,10"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#857C8F"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
 </Window.Resources>
 <ScrollViewer Background="#FAF9FC" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,24,24,24">
   <Grid Height="173"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="GPT DRAGON PET  /  龙娘" Foreground="#887295" FontSize="11" Margin="0,0,0,13"/><TextBlock Text="把认真，留在身边。" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="写代码、想事情，或者一起发会儿呆。" Style="{StaticResource Muted}" Margin="0,9,0,15"/><Border Background="#ECE5F4" CornerRadius="10" HorizontalAlignment="Left" Padding="10,5"><TextBlock x:Name="Status" Text="在这里陪你" Foreground="#77558D" FontSize="11"/></Border></StackPanel>
    <Image x:Name="Portrait" Grid.Column="1" Width="120" Height="160" Stretch="Uniform"/>
   </Grid>
   <Border Background="White" CornerRadius="16" Padding="20,18" Margin="0,12,0,12" BorderBrush="#ECE8F0" BorderThickness="1"><StackPanel>
    <DockPanel><Button x:Name="Auto" DockPanel.Dock="Right" Content="回到自动" Padding="10,5" Margin="8,0,0,10" FontSize="11"/><TextBlock Text="今天是什么心情" Style="{StaticResource Heading}"/></DockPanel>
    <UniformGrid Columns="3"><Button x:Name="Think" Tag="thinking" Content="想一想"/><Button x:Name="Work" Tag="working" Content="抱起电脑"/><Button x:Name="Wait" Tag="waiting" Content="等你回来"/><Button x:Name="Done" Tag="done" Content="完成啦"/><Button x:Name="Pet" Tag="pet" Content="摸摸脑袋"/><Button x:Name="Sleep" Tag="sleep" Content="休息一下"/></UniformGrid>
   </StackPanel></Border>
   <Border Background="White" CornerRadius="16" Padding="20,18" Margin="0,0,0,12" BorderBrush="#ECE8F0" BorderThickness="1"><StackPanel>
    <TextBlock Text="舒服地待在桌面上" Style="{StaticResource Heading}"/>
    <DockPanel Margin="0,2,0,10"><TextBlock x:Name="SizeValue" Text="220 px" DockPanel.Dock="Right" Foreground="#887295" FontSize="12"/><TextBlock Text="角色大小" FontSize="13"/></DockPanel>
    <Slider x:Name="Size" Minimum="140" Maximum="340" Value="220" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,10" AutomationProperties.Name="角色大小"/>
    <UniformGrid Columns="2"><CheckBox x:Name="Topmost" Content="一直在最前面"/><CheckBox x:Name="Roam" Content="闲时散散步"/><CheckBox x:Name="IdleActions" Content="待机时随机小动作"/><CheckBox x:Name="Bubbles" Content="显示心情气泡"/><CheckBox x:Name="Reduced" Content="减少动态效果"/></UniformGrid>
    <Button x:Name="Reset" Content="回到屏幕角落" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,7" FontSize="12"/>
   </StackPanel></Border>
   <Border Background="White" CornerRadius="16" Padding="20,18" BorderBrush="#ECE8F0" BorderThickness="1"><StackPanel>
    <TextBlock Text="陪你把事情做好" Style="{StaticResource Heading}"/><TextBlock x:Name="Connection" Text="选择一个 Codex 会话，跟随工作状态。" Style="{StaticResource Muted}"/>
    <WrapPanel Margin="0,12,0,0"><Button x:Name="Connect" Content="选择会话" Background="#EDE5F6"/><Button x:Name="Disconnect" Content="断开连接"/></WrapPanel>
    <TextBlock Text="只在本机读取所选会话的状态，不上传日志，也不调用模型。" Style="{StaticResource Muted}" FontSize="11"/>
   </StackPanel></Border>
   <TextBlock Text="拖动可以搬家，轻甩可以溜一圈。右键角色或托盘图标，随时回来。" Style="{StaticResource Muted}" FontSize="11" Margin="2,16,0,0"/>
  </StackPanel>
 </ScrollViewer>
</Window>
