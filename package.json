{
  "name": "gpt-whale-pet",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "GPT 白龙娘角色包，直接使用 dsh-pet 原版动画和桌面运行底座。",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "runtime:install": "node src/engine.mjs --install-electron",
    "preview": "node src/run.mjs --preview",
    "start": "node src/run.mjs",
    "start:full": "node src/run.mjs --full",
    "stop": "node src/control.mjs stop",
    "status": "node src/control.mjs status",
    "media:list": "node scripts/media.mjs list",
    "media:prompt": "node scripts/recipes.mjs show",
    "media:recipes": "node scripts/recipes.mjs export",
    "media:process": "node scripts/media.mjs process",
    "media:import": "node scripts/media.mjs import",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:native": "node scripts/smoke.mjs"
  },
  "dependencies": { "dsh-pet": "0.3.7" }
}
